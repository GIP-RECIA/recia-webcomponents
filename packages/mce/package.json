{
  "name": "@gip-recia/mce",
  "type": "module",
  "version": "0.0.0",
  "description": "",
  "contributors": [
    {
      "name": "Quentin Guillemin",
      "email": "quentin.guillemin@recia.fr",
      "url": "https://github.com/Quentin-Guillemin"
    }
  ],
  "license": "Apache-2.0",
  "homepage": "https://github.com/GIP-RECIA/recia-webcomponents/tree/main/packages/mce/#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GIP-RECIA/recia-webcomponents.git"
  },
  "bugs": {
    "url": "https://github.com/GIP-RECIA/recia-webcomponents/issues"
  },
  "keywords": [
    "mce",
    "gip-recia"
  ],
  "exports": {
    ".": {
      "import": "./dist/mce.js"
    }
  },
  "module": "./dist/mce.js",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "dotenv-checker && vite --host",
    "build": "run-p type-check build-only && yarn run build:min",
    "build:min": "yarn exec terser -c -m --module -f comments=false -o dist/mce.min.js -- dist/mce.js",
    "lint": "eslint src/*",
    "preview": "vite preview",
    "test:unit": "vitest",
    "build-only": "vite build",
    "type-check": "vue-tsc --noEmit",
    "release": "yarn run -T commit-and-tag-version -t 'mce/v' --path . --release-as $1 || echo 'Please specify a version type (yarn run release -- [patch, minor, major])'"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.5.1",
    "@fortawesome/fontawesome-svg-core": "^7.3.1",
    "@fortawesome/free-solid-svg-icons": "^7.3.1",
    "@fortawesome/vue-fontawesome": "^3.3.3",
    "@gip-recia/ui": "^1.1.0",
    "@intlify/unplugin-vue-i18n": "^11.2.5",
    "@tsconfig/node24": "^24.0.5",
    "@types/node": "^24",
    "@types/regenerator-runtime": "^0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@uportal/open-id-connect": "^1.40.2",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vue/test-utils": "^2.5.1",
    "@vue/tsconfig": "^0.9.1",
    "dotenv-checker": "^1.1.7",
    "eslint": "^10.11.0",
    "eslint-plugin-format": "^2.0.1",
    "jsdom": "^30.1.1",
    "npm-run-all2": "^9.0.3",
    "regenerator-runtime": "^0.14.1",
    "ress": "^6.0.0",
    "sass": "^1.105.0",
    "terser": "^5.51.2",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.3",
    "vue": "^3.5.43",
    "vue-advanced-cropper": "^2.8.9",
    "vue-i18n": "^11.4.12",
    "vue-tsc": "^3.3.11"
  }
}
